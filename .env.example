# Copy to .env for local builds. In production, set as GitHub Actions secrets (Settings → Secrets).

# Google Search Console — HTML tag verification (meta name="google-site-verification")
PUBLIC_GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools — meta name="msvalidate.01"
PUBLIC_BING_SITE_VERIFICATION=

# Analytics (pick one)
# Plausible: set domain only, e.g. perfsage.com
PUBLIC_PLAUSIBLE_DOMAIN=
# Google Analytics 4: measurement ID, e.g. G-XXXXXXXXXX
PUBLIC_GA_MEASUREMENT_ID=
