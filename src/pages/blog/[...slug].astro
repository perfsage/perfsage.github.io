---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteNav from '../../components/SiteNav.astro';
import SiteFooter from '../../components/SiteFooter.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.mdx?$/, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const allPosts = await getCollection('blog', ({ data }) => !data.draft);

const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

const readingTime = Math.max(1, Math.ceil(post.body!.split(/\s+/).length / 200));

const slug = post.id.replace(/\.mdx?$/, '');
const postUrl = `https://perfsage.com/blog/${slug}/`;
const ogImage = post.data.heroImage ?? '/images/perfsage-logo.png';
const modified = post.data.updatedDate ?? post.data.pubDate;

const postSlug = (id: string) => id.replace(/\.mdx?$/, '');

const relatedPosts = allPosts
  .filter((p) => p.id !== post.id)
  .map((p) => ({
    post: p,
    score: p.data.tags.filter((tag) => post.data.tags.includes(tag)).length,
  }))
  .sort(
    (a, b) =>
      b.score - a.score ||
      b.post.data.pubDate.getTime() - a.post.data.pubDate.getTime(),
  )
  .slice(0, 3)
  .map((entry) => entry.post);

const blogSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.pubDate.toISOString(),
    dateModified: modified.toISOString(),
    author: {
      '@type': 'Person',
      name: post.data.author,
      url: 'https://perfsage.com/about/',
    },
    image: ogImage.startsWith('http') ? ogImage : `https://perfsage.com${ogImage}`,
    mainEntityOfPage: {
      '@type': 'WebPage',
      '@id': postUrl,
    },
    publisher: {
      '@type': 'Organization',
      name: 'PerfSage',
      logo: {
        '@type': 'ImageObject',
        url: 'https://perfsage.com/images/perfsage-logo.png',
      },
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://perfsage.com/' },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://perfsage.com/blog/' },
      { '@type': 'ListItem', position: 3, name: post.data.title, item: postUrl },
    ],
  },
];
---

<BaseLayout
  title={post.data.title + ' — PerfSage Blog'}
  description={post.data.description}
  ogImage={ogImage}
  pageType="article"
  articlePublishedTime={post.data.pubDate.toISOString()}
  articleModifiedTime={modified.toISOString()}
  articleAuthor={post.data.author}
  schema={blogSchema}
>
  <SiteNav />

  <main>
    <!-- Post header -->
    <header class="post-hero">
      <div class="container post-hero-inner">
        <div class="blog-tag-row" data-reveal>
          {post.data.tags.map((tag) => <span class="blog-tag">{tag}</span>)}
        </div>

        <h1 class="post-title" data-reveal>{post.data.title}</h1>
        <p class="post-desc" data-reveal>{post.data.description}</p>

        <div class="post-meta" data-reveal>
          <img
            src="/images/aashish-bajpai.png"
            alt={post.data.author}
            class="post-avatar"
            width="36"
            height="36"
            loading="lazy"
          />
          <span class="post-author">{post.data.author}</span>
          <span class="post-meta-sep" aria-hidden="true">&middot;</span>
          <time datetime={post.data.pubDate.toISOString()}>{fmtDate(post.data.pubDate)}</time>
          {post.data.updatedDate && (
            <>
              <span class="post-meta-sep" aria-hidden="true">&middot;</span>
              <span>Updated {fmtDate(post.data.updatedDate)}</span>
            </>
          )}
          <span class="post-meta-sep" aria-hidden="true">&middot;</span>
          <span>{readingTime} min read</span>
        </div>
      </div>
    </header>

    <!-- Post body -->
    <section class="section" style="padding-top: 0;">
      <div class="container">
        <div class="post-layout">
          <div class="post-main">
            <article class="prose card">
              <Content />
            </article>

            {relatedPosts.length > 0 && (
              <section class="related-posts card" aria-labelledby="related-posts-heading">
                <h2 id="related-posts-heading" class="card-heading">Related Field Notes</h2>
                <ul class="related-posts__list">
                  {relatedPosts.map((related) => (
                    <li>
                      <a href={`/blog/${postSlug(related.id)}/`} class="related-posts__link">
                        <span class="related-posts__title">{related.data.title}</span>
                        <span class="related-posts__desc">{related.data.description}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </section>
            )}
          </div>

          <!-- Sidebar -->
          <aside class="post-sidebar">
            <div class="card sidebar-card" style="position:sticky;top:88px;">
              <h3 class="card-heading" style="margin-bottom:14px;">PerfSage tools</h3>
              <div style="display:flex;flex-direction:column;gap:8px;margin-bottom:18px;">
                <a class="btn btn-outline sidebar-tool-link" href="/reveal/">Reveal — JTL analysis</a>
                <a class="btn btn-outline sidebar-tool-link" href="/signalpilot/">SignalPilot — K8s RCA</a>
                <a class="btn btn-outline sidebar-tool-link" href="/slo-plugin/">SLO Reporter plugin</a>
              </div>

              <h3 class="card-heading" style="margin-bottom:14px;">About the author</h3>
              <div style="display:flex;align-items:center;gap:12px;margin-bottom:12px;">
                <img
                  src="/images/aashish-bajpai.png"
                  alt="Aashish Bajpai"
                  width="48"
                  height="48"
                  style="width:48px;height:48px;border-radius:50%;object-fit:cover;object-position:center top;border:2px solid rgba(124,106,247,0.35);"
                  loading="lazy"
                />
                <div>
                  <div style="font-weight:700;">Aashish Bajpai</div>
                  <div class="tiny-muted">Senior Performance Engineer</div>
                </div>
              </div>
              <p style="font-size:0.85rem;color:var(--muted);line-height:1.55;">
                9+ years in performance &amp; reliability engineering — VMware, EY, Oracle and more.
              </p>
              <div style="margin-top:14px;display:flex;flex-direction:column;gap:8px;">
                <a
                  class="btn btn-primary"
                  href="https://topmate.io/abajpai/659595"
                  target="_blank"
                  rel="noopener noreferrer"
                  style="text-align:center;font-size:0.85rem;padding:9px 16px;"
                >&#128197; Book a Call</a>
                <a
                  class="btn btn-outline"
                  href="/blog/"
                  style="text-align:center;font-size:0.85rem;padding:9px 16px;"
                >&#8592; All Posts</a>
              </div>
            </div>
          </aside>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>

<style>
  .related-posts {
    margin-top: 20px;
    padding: 20px;
  }

  .related-posts__list {
    list-style: none;
    margin: 14px 0 0;
    padding: 0;
    display: grid;
    gap: 12px;
  }

  .related-posts__link {
    display: block;
    padding: 12px 14px;
    border: 1px solid var(--stroke);
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: border-color 0.15s, background 0.15s;
  }

  .related-posts__link:hover {
    border-color: rgba(124, 106, 247, 0.45);
    background: rgba(124, 106, 247, 0.06);
  }

  .related-posts__title {
    display: block;
    font-weight: 600;
    color: var(--text);
    font-size: 0.95rem;
    line-height: 1.4;
  }

  .related-posts__desc {
    display: block;
    margin-top: 4px;
    font-size: 0.82rem;
    color: var(--muted);
    line-height: 1.45;
  }

  .sidebar-tool-link {
    text-align: center;
    font-size: 0.82rem;
    padding: 8px 12px;
  }
</style>